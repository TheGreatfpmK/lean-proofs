{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "docs/aurora.md"
  ],
  "skills": {
    "paths": [
      "vendor/lean4-skills/plugins/lean4/skills"
    ]
  },
  "mcp": {
    "lean-lsp": {
      "type": "local",
      "command": [
        "bash",
        "scripts/mcp-lean-lsp"
      ],
      "enabled": true,
      "timeout": 180000
    }
  },
  "permission": {
    "bash": {
      "lake": "deny",
      "lake *": "deny",
      "lean": "deny",
      "lean *": "deny",
      "elan *": "deny"
    }
  },
  "watcher": {
    "ignore": [
      ".lake/**"
    ]
  },
  "provider": {
    "ostrava": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ostrava",
      "options": {
        "baseURL": "https://llm.ai.e-infra.cz/v1",
        "apiKey": "{env:OSTRAVA_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "DeepSeek v4.1 Flash",
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 1048576
          }
        },
        "deepseek-v4.1-flash-thinking": {
          "name": "DeepSeek v4.1 Flash Thinking",
